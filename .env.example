# === Configuration du modèle IA (endpoint compatible OpenAI) ===
# URL de base de l'API, SANS le /chat/completions final
# Exemples : https://api.openai.com/v1  |  http://localhost:11434/v1  |  https://mon-serveur/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Nombre max de tokens pour la génération d'un jeu. Prévoir large : les jeux
# complets sont longs ET les modèles à raisonnement (Gemini, o-series…)
# consomment une partie de ce budget pour "réfléchir" avant d'écrire.
OPENAI_MAX_TOKENS=50000

# Raisonnement des modèles "thinking" : none (désactivé — rapide, recommandé
# pour une bonne expérience élève) | low/medium/high (effort limité) |
# default (ne rien envoyer).
# Avec "none", on envoie à la fois le format OpenRouter (reasoning.enabled=false)
# et le format vLLM/SGLang (chat_template_kwargs.enable_thinking=false) ; si le
# serveur rejette ces champs, la requête est automatiquement retentée sans eux.
# NB : même si le serveur ignore tout et "réfléchit" quand même, la réflexion
# (deltas reasoning_content ou balises <think> dans le contenu) est correctement
# séparée du code du jeu — elle ne casse plus le parsing.
OPENAI_REASONING_EFFORT=none

# Température d'échantillonnage (0.6 par défaut : code plus fiable que 0.7+)
OPENAI_TEMPERATURE=0.6

# === Sécurité ===
# (SESSION_SECRET n'est plus utilisé depuis la refonte des sessions :
#  les tokens sont aléatoires et stockés en base sous forme de SHA-256.)

# Le cookie de session est marqué "secure" en production (HTTPS uniquement).
# Déploiement en HTTP pur (réseau interne sans TLS) : décommenter la ligne suivante.
# SESSION_SECURE_COOKIE=0

# Déclarer un reverse proxy de confiance qui ÉCRASE x-forwarded-for (nginx,
# traefik…) : les fenêtres anti-abus identifient alors chaque client par sa
# vraie IP. Sans cette variable, les plafonds par IP deviennent globaux —
# la protection par compte (10 tentatives/minute) reste active dans tous les cas.
# TRUST_PROXY=1

# === Connexion SSO (OIDC) — optionnel ===
# Renseigner les TROIS variables suivantes pour activer le bouton
# « Se connecter via le SSO de l'université » sur la page de connexion.
# Exemple (CAS 7 de l'UPPA) : l'issuer est l'URL sans /.well-known/openid-configuration.
OIDC_ISSUER=https://sso.univ-pau.fr/cas/oidc
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# L'URI de rappel https://…/api/auth/oidc/callback doit être DÉCLARÉE auprès du
# service SSO de l'université (client confidentiel). En production derrière un
# reverse proxy, fixer explicitement :
# OIDC_REDIRECT_URI=https://learngame.mon-domaine.fr/api/auth/oidc/callback
# Scopes demandés (défaut : openid profile email).
# OIDC_SCOPES=openid profile email
# Restreindre aux domaines e-mail (suffixes séparés par des virgules, sous-
# domaines inclus). Vide = toutes les identités délivrées par l'IdP.
# OIDC_ALLOWED_DOMAINS=univ-pau.fr
# Authentification au token endpoint : post (défaut) ou basic. Le défaut de
# la librairie est « post » dès qu'un secret est fourni ; mettre « basic » si
# l'IdP ne liste pas client_secret_post dans sa découverte.
# OIDC_TOKEN_AUTH=post

# === Inscription ===
# Noms d'utilisateur (séparés par des virgules) promus automatiquement admin
# (role='admin', status='approved') à l'inscription ou au démarrage du serveur.
# Sert à créer le premier compte admin : inscris-toi normalement une première
# fois (compte en attente), puis renseigne cette variable avec ton nom
# d'utilisateur et redémarre le serveur — ou renseigne-la avant ta première
# inscription avec ce nom pour être admin dès la création du compte.
ADMIN_USERNAMES=mohamad
